# chat-agent — TLS front for the node app.
#
# Caddy automatically obtains and renews TLS certificates for all your sites
# (https://caddyserver.com/docs/caddyfile/directives/tls). A LAN address has
# no public domain, so the leaf cert is issued from Caddy's own internal CA
# (still fully local — see scripts/cert.sh, which signs with the CA that
# Caddy maintains in its storage). Re-run scripts/cert.sh when the machine's
# LAN IP changes. Websockets (wss://…/ws) are proxied transparently — Caddy
# passes the HTTP/1.1 101 upgrade straight through to the node process.
#
# Browser:  https://<host-ip>:4242/        (node edge shim, 0.0.0.0 —
#         sniffs TLS vs plain HTTP; plain HTTP gets a 301 to https)
# Caddy:   127.0.0.1:4443                  (TLS termination, loopback only)
# Node API: http://127.0.0.1:4243          (loopback only, behind Caddy)
#

{
	admin off
}

127.0.0.1:4443 {
	tls certs/chat-agent.crt certs/chat-agent.key
	reverse_proxy 127.0.0.1:4243
}
